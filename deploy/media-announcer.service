# /etc/systemd/system/media-announcer.service — for an always-on box on a
# network segment the media-server's own multicast doesn't reach reliably.
# Copy the server's media-server.toml (advertise_ip must be set) to this
# machine, fix the paths below, then systemctl enable --now.
[Unit]
Description=SSDP relay beacon for media-server
Wants=network-online.target
After=network-online.target

[Service]
User=pi
ExecStart=/home/pi/media_server/target/release/media-announcer --config /home/pi/media_server/media-server.toml
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only

# Sandboxing beyond the basics above: no capabilities, only the socket
# families the binaries use (NETLINK is how interfaces are enumerated),
# no namespaces/kernel knobs/devices/other processes' /proc, a native
# syscall allow-list, and a memory ceiling so a crafted media file cannot
# take the whole box down with it.
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
PrivateDevices=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
MemoryMax=128M
TasksMax=32

[Install]
WantedBy=multi-user.target
