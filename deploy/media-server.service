# /etc/systemd/system/media-server.service
# Before installing:
#   1. Set User= to your actual account (`whoami`) — newer Raspberry Pi OS
#      images have no `pi` user. A wrong user fails with status=217/USER.
#   2. Fix every /home/pi and /mnt/media path to match your install.
#   3. Pre-create the catalog directory (mkdir -p ~/.local/state/mediaserver):
#      ReadWritePaths targets must exist when the unit starts, or the
#      sandbox fails with status=226/NAMESPACE.
#   4. ADDING A MEDIA ROOT LATER? Update RequiresMountsFor here AND (scanner
#      unit) add the new mount to ReadWritePaths — ProtectSystem=strict makes
#      everything else read-only, so enrichment writes fail with EROFS
#      ("Read-only file system") on the new volume until it is listed.
[Unit]
Description=UPnP media server
Wants=network-online.target
After=network-online.target media-scanner.service
RequiresMountsFor=/mnt/media

[Service]
User=pi
ExecStart=/home/pi/media_server/target/release/media-server --config /home/pi/media_server/media-server.toml
# On first boot the server exits until the scanner has created/migrated the
# catalog; Restart covers that window.
Restart=on-failure
RestartSec=10

# Hardening: the server only reads — media, catalog, nothing else.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
# The .uuid file is created next to the db on first run.
ReadWritePaths=/home/pi/.local/state/mediaserver
# HTTPS ([tls] in media-server.toml): the service re-reads `cert`/`key`
# every reload_secs, so renewals are picked up without a restart — provided
# the files it reads are the ones being renewed. Let's Encrypt's live/ files
# are root-only, so install a certbot deploy hook that copies them somewhere
# this User= can read (ProtectSystem=strict still allows reading /etc):
#   /etc/letsencrypt/renewal-hooks/deploy/mediaserver.sh
#     install -o root -g pi -m 0640 "$RENEWED_LINEAGE/fullchain.pem" /etc/mediaserver/fullchain.pem
#     install -o root -g pi -m 0640 "$RENEWED_LINEAGE/privkey.pem"   /etc/mediaserver/privkey.pem
# (LoadCredential= would also expose them, but it copies at service start
# only, so a renewal would then need a restart to take effect.)
# To listen on 443 (or any port below 1024) as this unprivileged User=,
# grant just the port-binding capability; NoNewPrivileges keeps everything
# else as tight as before:
#AmbientCapabilities=CAP_NET_BIND_SERVICE
#CapabilityBoundingSet=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
