# /etc/systemd/system/media-server.service
# Before installing:
#   1. Set User= to your actual account (`whoami`) — newer Raspberry Pi OS
#      images have no `pi` user. A wrong user fails with status=217/USER.
#   2. Fix every /home/pi and /mnt/media path to match your install.
#   3. Pre-create the catalog directory (mkdir -p ~/.local/state/mediaserver):
#      ReadWritePaths targets must exist when the unit starts, or the
#      sandbox fails with status=226/NAMESPACE.
#   4. ADDING A MEDIA ROOT LATER? Update RequiresMountsFor here AND (scanner
#      unit) add the new mount to ReadWritePaths — ProtectSystem=strict makes
#      everything else read-only, so enrichment writes fail with EROFS
#      ("Read-only file system") on the new volume until it is listed.
[Unit]
Description=UPnP media server
Wants=network-online.target
After=network-online.target media-scanner.service
RequiresMountsFor=/mnt/media

[Service]
User=pi
ExecStart=/home/pi/media_server/target/release/media-server --config /home/pi/media_server/media-server.toml
# On first boot the server exits until the scanner has created/migrated the
# catalog; Restart covers that window.
Restart=on-failure
RestartSec=10

# Hardening: the server only reads — media, catalog, nothing else.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
# The .uuid file is created next to the db on first run.
ReadWritePaths=/home/pi/.local/state/mediaserver
# HTTPS ([tls] in media-server.toml): hand the certificate and key to the
# service with systemd credentials — the service reads them as
# $CREDENTIALS_DIRECTORY/cert.pem and key.pem, so point `cert`/`key` there.
# Root-owned files stay root-owned and the sandbox stays as tight as it is.
# (For a Let's Encrypt certificate, name the live/ files here.)
#LoadCredential=cert.pem:/etc/letsencrypt/live/media.example.net/fullchain.pem
#LoadCredential=key.pem:/etc/letsencrypt/live/media.example.net/privkey.pem

[Install]
WantedBy=multi-user.target
