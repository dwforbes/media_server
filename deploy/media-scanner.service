# /etc/systemd/system/media-scanner.service
# Before installing:
#   1. Set User= to your actual account (`whoami`) — newer Raspberry Pi OS
#      images have no `pi` user. A wrong user fails with status=217/USER.
#   2. Fix every /home/pi and /mnt/media path to match your install.
#   3. Pre-create the catalog directory (mkdir -p ~/.local/state/mediaserver):
#      ReadWritePaths targets must exist when the unit starts, or the
#      sandbox fails with status=226/NAMESPACE.
#   4. ADDING A MEDIA ROOT LATER? Update RequiresMountsFor here AND (scanner
#      unit) add the new mount to ReadWritePaths — ProtectSystem=strict makes
#      everything else read-only, so enrichment writes fail with EROFS
#      ("Read-only file system") on the new volume until it is listed.
[Unit]
Description=Media catalog scanner (watch + reconcile + auto-enrich)
Wants=network-online.target
After=network-online.target
# Don't start until the media share is mounted; adjust to your mount point.
RequiresMountsFor=/mnt/media

[Service]
User=pi
ExecStart=/home/pi/media_server/target/release/media-scanner --config /home/pi/media_server/media-scanner.toml
# TMDB_API_KEY lives here, root-owned mode 600 — not in this unit, where
# any local user could read it via `systemctl show`.
EnvironmentFile=/etc/mediaserver/enrich.env
Restart=on-failure
RestartSec=10

# Hardening: no privilege escalation, read-only system, writable only where
# needed (catalog db + the share, which enrichment writes sidecars to).
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/pi/.local/state/mediaserver /mnt/media

[Install]
WantedBy=multi-user.target
